<?xml version="1.0" encoding="UTF-8"?>
<project name="MusicLibraryManagementSystem" default="run" basedir=".">

    <property name="src.dir" value="src"/>
    <property name="build.dir" value="build"/>
    <property name="dist.dir" value="dist"/>
    <property name="lib.dir" value="lib"/>
    <property name="main.class" value="ua.notion.musiclibrary.Main"/>

    <path id="classpath">
        <fileset dir="${lib.dir}" includes="**/*.jar"/>
        <pathelement path="${build.dir}"/>
    </path>

    <target name="clean" description="Видаляє директорії збірки">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="init">
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <target name="compile" depends="init" description="Компілює вихідний код">
        <javac srcdir="${src.dir}" 
               destdir="${build.dir}" 
               includeantruntime="false"
               encoding="UTF-8">
            <classpath refid="classpath"/>
        </javac>
    </target>

    <target name="jar" depends="compile" description="Створює JAR файл">
        <jar destfile="${dist.dir}/MusicLibrary.jar" basedir="${build.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
            </manifest>
        </jar>
    </target>

    <target name="run" depends="compile" description="Запускає додаток">
        <echo message="Запуск ${main.class}..."/>
        <java classname="${main.class}" fork="true">
            <jvmarg value="--add-opens=java.base/java.time=ALL-UNNAMED"/>
            <classpath refid="classpath"/>
        </java>
    </target>

</project>
